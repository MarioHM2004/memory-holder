# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The Sunday email (docs/weekly-email.md). Server-side only — never prefix
# these with NEXT_PUBLIC_.
# service_role bypasses Row Level Security on every table.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Shared with the GitHub workflow that triggers the send.
CRON_SECRET=
# Only needed where the site isn't memory-holder.com.
NEXT_PUBLIC_SITE_URL=
